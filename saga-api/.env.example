DATABASE_URL=postgresql://saga_api_user:<app-password>@host.docker.internal:5432/saga_db
# Superuser creds, dev-migration-time only (shadow DB creation needs CREATEDB)
SHADOW_DATABASE_URL=postgresql://pgadmin:<superuser-password>@host.docker.internal:5432/postgres
PORT=3000

NTFY_URL=http://host.docker.internal:8090
NTFY_TOPIC=<your-obscure-topic-name>

OLLAMA_URL=http://host.docker.internal:11434
ANTHROPIC_API_KEY=
WHISPER_URL=http://host.docker.internal:8100
# From `claude setup-token` on a device logged into your Pro/Max account —
# lets the claude_cli provider run headlessly using your subscription's own
# usage limits instead of paid API billing. Last-resort provider only.
CLAUDE_CODE_OAUTH_TOKEN=
# Date you ran `claude setup-token` to generate the value above (YYYY-MM-DD).
# Purely for the Settings page's "days left" display — the token itself is a
# flat one-year OAuth token, so this is just issuance-date + 365 days.
CLAUDE_CODE_OAUTH_TOKEN_ISSUED_AT=
